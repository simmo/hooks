{
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx --watch ./scripts/index.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --ext .tsx,.ts ./packages",
    "lint:fix": "eslint --ext .tsx,.ts ./packages --fix",
    "report": "tsx ./scripts/build-report.ts",
    "start": "tsx ./scripts/index.ts",
    "test": "vitest"
  },
  "prettier": {
    "arrowParens": "avoid",
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "jsx": true,
      "useJSXTextNode": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react/recommended",
      "plugin:prettier/recommended",
      "prettier/@typescript-eslint"
    ],
    "plugins": [
      "@typescript-eslint",
      "react-hooks",
      "react"
    ],
    "ignorePatterns": [
      "*.d.ts",
      "node_modules/"
    ],
    "rules": {
      "@typescript-eslint/explicit-function-return-type": "off",
      "sort-keys": "error",
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "warn"
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/vite-react": "^8.0.6",
    "@types/listr": "^0.14.10",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^2.26.0",
    "@typescript-eslint/parser": "^2.26.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.9.0",
    "eslint-plugin-prettier": "^3.1.2",
    "eslint-plugin-react": "^7.19.0",
    "eslint-plugin-react-hooks": "^3.0.0",
    "filesize": "^11.0.17",
    "gzip-size": "^7.0.0",
    "happy-dom": "^20.10.2",
    "inquirer": "^14.0.2",
    "jest-serializer-path": "^0.1.15",
    "listr": "^0.14.3",
    "ora": "^4.0.3",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-test-renderer": "^19.2.7",
    "terser": "^5.48.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "yoctocolors": "^2.1.2"
  }
}
