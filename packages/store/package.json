{
  "name": "@hooks/store",
  "description": "React hook to provide an observable global store",
  "type": "module",
  "keywords": [
    "react",
    "hooks",
    "store"
  ],
  "version": "0.1.0",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "author": "Mike Simmonds (https://mike.id)",
  "license": "MIT",
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsx ../../scripts/build.ts",
    "typecheck": "tsx ../../scripts/typecheck.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "dependencies": {
    "shallowequal": "^1.1.0"
  },
  "devDependencies": {
    "@types/shallowequal": "^1.1.5",
    "react": "^19.2.7"
  }
}
